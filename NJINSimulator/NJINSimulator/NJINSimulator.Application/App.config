<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
	</configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="RequestManager" value="Consumer.REQMGR_IN.VirtualTopic.IO_OUT|PO.IN|50"/>
		<add key="PipelineOrchestratorIn" value="PO.IN|VALIDATOR.IN|10"/>
		<add key="Validator" value="VALIDATOR.IN|ROUTER_DEST.IN|10"/>
		<add key="RouterDestInfo" value="ROUTER_DEST.IN|ROUTER_ROUTE.IN|20"/>
		<add key="RouterRoute" value="ROUTER_ROUTE.IN|IMGPROC.IN|10"/>
		<add key="ImageProcessor" value="IMGPROC.IN|CONVERSION.IN|50"/>
		<add key="Conversion" value="CONVERSION.IN|PO.IN.TEMP|10"/>
		<add key="PipelineOrchestratorOut" value="PO.IN.TEMP|VirtualTopic.PO_OUT|10"/>
		<add key="SenderManager" value="Consumer.SNDMGR_IN.VirtualTopic.PO_OUT|http://localhost:9199/njinsimulator/io/api/v1/NSBIn|50"/>
	</appSettings>
	<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" internalLogLevel="On" internalLogFile="C:\dev.net\Sandbox\_Logs\nlog-internal.log">
		<targets>
			<target name="file_NJINSimulator" xsi:type="File"
            layout="[${threadid}] ${longdate} ${level:uppercase=true} ${message} ${exception:format=ToString}"
            fileName="C:\dev.net\Sandbox\_Logs\NJINSimulator_${shortdate}.log"
            keepFileOpen="true"
            encoding="utf-8" />
			<target name="file_NJINSimulator_modules" xsi:type="File"
            layout="[${threadid}] ${longdate} ${level:uppercase=true} ${message} ${exception:format=ToString}"
            fileName="C:\dev.net\Sandbox\_Logs\NJINSimulator_MODULES_${shortdate}.log"
            keepFileOpen="true"
            encoding="utf-8" />
		</targets>
		<rules>
			<logger name="*" levels="Debug,Info,Warn,Error,Fatal" writeTo="file_NJINSimulator" />
			<logger name="NJIN" levels="Debug,Info,Warn,Error,Fatal" writeTo="file_NJINSimulator_modules" />
		</rules>
	</nlog>
</configuration>