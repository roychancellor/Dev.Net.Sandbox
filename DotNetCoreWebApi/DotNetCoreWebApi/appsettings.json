{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "ApplicationName": "MotorcycleApiCaller",
    "ServiceName": "DotNetCoreWebApi",
    "XpathNamespace": "http://www.royware.com",
    "XpathNamespacePrefix": "rw",
    "XpathUrl": "//rw:Motorcycle/rw:Facts/rw:URL"
  },
  "NLog": {
    "LoggingConfiguration": "nlog.config"
  }
}
