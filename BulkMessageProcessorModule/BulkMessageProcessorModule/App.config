<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add name="NJINExpressConnection" connectionString="Server=localhost;Integrated Security=true;Initial Catalog=NJINExpress"/>
	</connectionStrings>
	<appSettings>
		<add key="SourceFilePath" value="c:\dev.net\sandbox"/>
		<add key="ProcSourceFileInsert" value="dbo.uspInsertSourceFile"/>
	</appSettings>
</configuration>